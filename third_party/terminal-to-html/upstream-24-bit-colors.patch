 ```
 
-For coloring you can use the sample [terminal.css](/internal/assets/terminal.css) stylesheet and wrap the output in an element with class `term-container` (e.g. `<div class="term-container"><!-- terminal output --></div>`).
+For coloring you can use the sample [terminal.css](/internal/assets/terminal.css) stylesheet and wrap the output in an element with class `term-container` (e.g. `<div class="term-container"><!-- terminal output --></div>`). 24-bit colors (`ESC[38;2;r;g;bm` and `ESC[48;2;r;g;bm`) have no class; they are written as an inline `style` attribute on the span instead.
 
 ### iTerm2 Image support
 
diff --git a/output.go b/output.go
index f7e141b..c836e6f 100644
--- a/output.go
+++ b/output.go
@@ -18,7 +18,17 @@ func (b *outputBuffer) appendNodeStyle(n node) {
 	// the joined value is always [a-z0-9- ] — nothing to escape.
 	b.WriteString(`<span class="`)
 	b.WriteString(strings.Join(n.style.asClasses(), " "))
-	b.WriteString(`">`)
+	b.WriteString(`"`)
+	// There is no class for each of the 16.7 million 24-bit colors, so
+	// they are written as an inline style. asInlineStyle only ever emits
+	// "color:" or "background-color:" followed by "#" and 6 hex digits
+	// and ";" — nothing to escape.
+	if css := n.style.asInlineStyle(); css != "" {
+		b.WriteString(` style="`)
+		b.WriteString(css)
+		b.WriteString(`"`)
+	}
+	b.WriteString(`>`)
 }
 
 func (b *outputBuffer) closeStyle() {
