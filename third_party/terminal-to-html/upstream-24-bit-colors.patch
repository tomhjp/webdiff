 	}
 
 	if s.bold() {
@@ -142,6 +140,30 @@ func (s style) asClasses() []string {
 	return styles
 }
 
+// asInlineStyle returns the CSS declarations for the style's 24-bit colors,
+// or "" if it has none.
+func (s style) asInlineStyle() string {
+	var css string
+	if s.fgColorType() == color24Bit {
+		css += "color:" + hexColor(s.fgColor()) + ";"
+	}
+	if s.bgColorType() == color24Bit {
+		css += "background-color:" + hexColor(s.bgColor()) + ";"
+	}
+	return css
+}
+
+// hexColor formats a 0xRRGGBB color as "#rrggbb".
+func hexColor(rgb uint32) string {
+	const digits = "0123456789abcdef"
+	b := []byte("#000000")
+	for i := 6; i > 0; i-- {
+		b[i] = digits[rgb&0xf]
+		rgb >>= 4
+	}
+	return string(b)
+}
+
