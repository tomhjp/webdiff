[Unit]
Description=webdiff git diff browser
After=default.target

[Service]
Type=simple
# The serve root: a directory *containing* your git repos, not a repo itself.
# __CODE_DIR__ is templated in by deploy/install.sh.
WorkingDirectory=__CODE_DIR__
# __SSH_HOST_ARG__ is either empty or "-ssh-host=<alias>", templated in by
# deploy/install.sh. It names how your *laptop* SSHes here, which the
# Zed/Ghostty buttons need and the server can't infer; without it they
# fall back to this node's MagicDNS name.
ExecStart=__CODE_DIR__/webdiff/webdiff __SSH_HOST_ARG__ 80
Restart=on-failure
RestartSec=2
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
